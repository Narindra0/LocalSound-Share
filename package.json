{
  "name": "localsound-share",
  "version": "0.1.5",
  "description": "Diffusion audio locale (WASAPI loopback) vers les navigateurs du réseau local",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "desktop": "node scripts/desktop.js",
    "test": "node --test tests/node/*.test.js",
    "notices": "node scripts/third-party-notices.js",
    "mobile:web": "node scripts/sync-mobile-web.js",
    "build:exe": "npm run notices && electron-builder --win portable --x64",
    "desktop:listener": "node scripts/listener.js",
    "build:listener": "npm run notices && node scripts/prepare-listener.js && electron-builder --config electron-builder-listener.yml --win portable --x64",
    "build:listener:lite": "npm run notices && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-lite.ps1",
    "build:setup": "node scripts/build-setup.js",
    "check:repo": "node scripts/check-repository.js",
    "setup:desktop": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lamejs": "^1.2.1",
    "loopback-capture": "^3.0.2",
    "music-metadata": "^12.2.1",
    "opus-decoder": "0.7.12",
    "opusscript": "0.1.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "4.3.2",
    "jsqr": "^1.4.0",
    "yazl": "^3.3.1"
  },
  "author": {
    "name": "Ranjalahy Narindra",
    "email": "ranjalahy.narindraa@gmail.com",
    "url": "https://narindraportfolio.netlify.app/"
  },
  "homepage": "https://narindraportfolio.netlify.app/",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Narindra0/LocalSound-Share.git"
  },
  "bugs": {
    "url": "https://github.com/Narindra0/LocalSound-Share/issues"
  }
}
