Source: "{#ConditionsFile}"; DestDir: "{app}"; DestName: "Conditions et confidentialite.txt"; Flags: ignoreversion
#include "files.iss"

[Icons]
Name: "{group}\LocalSound Hôte"; Filename: "{app}\LocalSound Hote.exe"; Components: host
Name: "{group}\LocalSound Auditeur Léger"; Filename: "{app}\LocalSound Auditeur Leger.exe"; Components: lite
Name: "{group}\LocalSound Auditeur"; Filename: "{app}\LocalSound Auditeur.exe"; Components: classic
Name: "{group}\Conditions et confidentialité"; Filename: "{app}\Conditions et confidentialite.txt"
Name: "{group}\Désinstaller LocalSound Share"; Filename: "{uninstallexe}"
Name: "{autodesktop}\LocalSound Hôte"; Filename: "{app}\LocalSound Hote.exe"; Components: host; Tasks: desktopicon
Name: "{autodesktop}\LocalSound Auditeur Léger"; Filename: "{app}\LocalSound Auditeur Leger.exe"; Components: lite; Tasks: desktopicon
Name: "{autodesktop}\LocalSound Auditeur"; Filename: "{app}\LocalSound Auditeur.exe"; Components: classic; Tasks: desktopicon

[Run]
Filename: "https://developer.microsoft.com/microsoft-edge/webview2/"; Description: "Obtenir le Runtime WebView2 requis par l’Auditeur Léger"; Flags: shellexec postinstall unchecked skipifsilent; Check: NeedsWebView2
Filename: "{app}\LocalSound Hote.exe"; Description: "Ouvrir l’Hôte"; Components: host; Flags: postinstall unchecked nowait skipifsilent
Filename: "{app}\LocalSound Auditeur Leger.exe"; Description: "Ouvrir l’Auditeur Léger"; Components: lite; Flags: postinstall unchecked nowait skipifsilent
Filename: "{app}\LocalSound Auditeur.exe"; Description: "Ouvrir l’Auditeur classique"; Components: classic; Flags: postinstall unchecked nowait skipifsilent

[Code]
var
  DownloadPage: TDownloadWizardPage;
  Prerequisites: TNewStaticText;

function HasWebView2: Boolean;
var
  Version: String;
  Key: String;
begin
  Key := 'Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}';
  Result := (RegQueryStringValue(HKCU, Key, 'pv', Version) and (Version <> '') and (Version <> '0.0.0.0')) or
    (RegQueryStringValue(HKLM32, Key, 'pv', Version) and (Version <> '') and (Version <> '0.0.0.0')) or
    (RegQueryStringValue(HKLM64, Key, 'pv', Version) and (Version <> '') and (Version <> '0.0.0.0'));
end;

function NeedsWebView2: Boolean;
begin
  Result := WizardIsComponentSelected('lite') and not HasWebView2;
end;

procedure InitializeWizard;
begin
  DownloadPage := CreateDownloadPage('Téléchargement des applications',
    'Seules les éditions choisies sont téléchargées. Vérification SHA-256 avant installation.', nil);
  DownloadPage.ShowBaseNameInsteadOfUrl := True;
  Prerequisites := TNewStaticText.Create(WizardForm);
  Prerequisites.Parent := WizardForm.SelectComponentsPage;
  Prerequisites.Left := WizardForm.ComponentsList.Left;
  Prerequisites.Top := WizardForm.ComponentsList.Top + WizardForm.ComponentsList.Height - ScaleY(56);
  Prerequisites.Width := WizardForm.ComponentsList.Width;
  Prerequisites.Height := ScaleY(54);
  Prerequisites.WordWrap := True;
  Prerequisites.Caption := 'Léger : .NET Framework 4.6.2+ et Microsoft WebView2 requis.' + #13#10 +
    'Hôte et classique : moteur embarqué. Les applications restent non signées.' + #13#10 +
    'Internet pour installer ; réseau local commun pour écouter.';
  WizardForm.ComponentsList.Height := WizardForm.ComponentsList.Height - ScaleY(64);
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  Result := '';
  if not (WizardIsComponentSelected('host') or WizardIsComponentSelected('lite') or WizardIsComponentSelected('classic')) then begin
    Result := 'Sélectionnez au moins une édition de LocalSound.';
    Exit;
  end;
  DownloadPage.Clear;
  #include "downloads.iss"
  DownloadPage.Show;
  try
    try
      DownloadPage.Download;
    except
      if DownloadPage.AbortedByUser then
        Result := 'Téléchargement annulé. Vous pouvez réessayer ou quitter.'
      else
        Result := 'Impossible de télécharger ou de vérifier les applications. Aucune application téléchargée ne sera installée. Vérifiez votre connexion puis réessayez.' + #13#10 + GetExceptionMessage;
    end;
  finally
    DownloadPage.Hide;
  end;
end;
