#include "payloads.iss"

[Setup]
AppId={{CCCA0D77-56DC-4F06-A84B-A36D9952A38F}
AppName=LocalSound Share
AppVersion={#AppVersion}
AppPublisher=Ranjalahy Narindra
AppPublisherURL=https://narindraportfolio.netlify.app/
AppSupportURL=https://github.com/Narindra0/LocalSound-Share/issues
AppUpdatesURL=https://github.com/Narindra0/LocalSound-Share/releases/latest
AppCopyright=Copyright © 2026 Ranjalahy Narindra
DefaultDirName={localappdata}\Programs\LocalSound Share
DefaultGroupName=LocalSound Share
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
MinVersion=10.0.19041
WizardStyle=modern
WizardSizePercent=115
WizardImageFile={#BrandImage}
WizardSmallImageFile={#BrandSmallImage}
SetupIconFile={#BrandIcon}
UninstallDisplayIcon={app}\LocalSound.ico
LicenseFile={#ConditionsFile}
InfoBeforeFile={#WelcomeFile}
DisableWelcomePage=no
DisableProgramGroupPage=auto
AllowNoIcons=yes
UsePreviousTasks=yes
CloseApplications=no
RestartApplications=no
ChangesAssociations=no
OutputDir={#OutputPath}
OutputBaseFilename=LocalSound-Setup-{#AppVersion}-Windows-x64
VersionInfoDescription=Installation de LocalSound Share
VersionInfoCompany=Ranjalahy Narindra
VersionInfoCopyright=Copyright © 2026 Ranjalahy Narindra
Compression=lzma2
SolidCompression=yes
UninstallDisplayName=LocalSound Share

[Languages]
Name: "french"; MessagesFile: "compiler:Languages\French.isl"

[Messages]
WelcomeLabel1=Bienvenue dans LocalSound Share
WelcomeLabel2=Les bons sons se partagent.%n%nCréé par Ranjalahy Narindra · Madagascar.%nProjet personnel gratuit.%n%nCet assistant installe les éditions de votre choix et crée leurs raccourcis. Une connexion Internet est nécessaire pour télécharger les applications sélectionnées.
SelectComponentsLabel2=Choisissez votre usage, puis ajustez les éditions à installer :
FinishedLabel=LocalSound Share est installé.%n%nCréé par Ranjalahy Narindra.%nLes raccourcis sont disponibles dans le menu Démarrer. Les conditions et informations de confidentialité restent accessibles dans chaque application.%n%nL’auditeur rejoint l’adresse réseau communiquée par l’hôte.

[Types]
Name: "listener"; Description: "Écouter — Auditeur Léger (6,53 Mo)"
Name: "host"; Description: "Diffuser — Hôte avec YouTube intégré (99,3 Mo)"
Name: "classic"; Description: "Écouter — Auditeur classique (96,5 Mo)"
Name: "custom"; Description: "Personnaliser — choisir plusieurs éditions"; Flags: iscustom

[Components]
Name: "host"; Description: "Hôte — créer un salon et diffuser (99,3 Mo)"; Types: host
Name: "lite"; Description: "Auditeur Léger — écouter avec WebView2 (6,53 Mo)"; Types: listener
Name: "classic"; Description: "Auditeur classique — moteur Electron inclus (96,5 Mo)"; Types: classic

[Tasks]
